# Security — never pushed
.env
.env.*
*.key
*.pem

# Private — assessment papers/keys and source references
assessment/
assessment_*/
reference/

# Private build source: build_assessment.py holds the WA/PP model answers,
# qa/ holds LMS/TMS push logs. Anchored to the root so lab solutions that
# contain .claude/ folders are still published.
/build/
/.claude/
/.codex/

# Superseded versions and regenerated files
**/archive/
**/__pycache__/
**/.DS_Store
